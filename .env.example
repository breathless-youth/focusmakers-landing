# 이 파일을 .env.local 로 복사해 값을 채운다.

# ── Supabase (베타 신청 저장) ────────────────────────────────────────
# 대시보드 > Project Settings > API
#
# Project URL 은 공개 값이라 미리 채워 뒀다. secret 키만 넣으면 된다.
SUPABASE_URL=https://oggpdtzpumjvrueirrvf.supabase.co

# "secret" 키. 예전 프로젝트라면 service_role 키도 된다.
#
# !! 이 파일은 git 에 추적된다. 실제 키를 여기 적지 말 것 !!
#    값은 .env.local 에만 넣는다 (.gitignore 로 무시됨).
#    RLS 를 우회하는 키라 유출되면 신청자 데이터가 전부 열린다.
SUPABASE_SECRET_KEY=

# ── Slack (선택) ─────────────────────────────────────────────────────
# 신청이 들어오면 알릴 Incoming Webhook. 비워 두면 알림 없이 저장만 한다.
SLACK_WEBHOOK_URL=
